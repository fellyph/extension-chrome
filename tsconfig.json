{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "*": ["node_modules/*", "src/*"]
    },
    "types": ["chrome", "react", "react-dom"]
  },
  "include": ["src/**/*", "src/utils/**/*", "src/types/**/*"],
  "exclude": ["node_modules", "dist"]
}
